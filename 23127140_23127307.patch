+// collect free memory
+uint64
+collect_freemem(void)
+{
+  struct run *r;
+  uint64 cnt = 0;// number of freemem
+
+  acquire(&kmem.lock);
+  r = kmem.freelist;
+
+  while(r){
+    r = r->next;
+    cnt++;
+  }
+  release(&kmem.lock);
+
